generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id                Int      @id @default(autoincrement())
  title             String
  date              DateTime    
  endDate           DateTime?   
  startTime         String
  endTime           String
  location          String
  description       String
  volunteerCapacity Int
  isActive Boolean @default(true)
  createdAt         DateTime @default(now())

createdByAdminId Int?
createdByAdmin   AdminUser? @relation(fields: [createdByAdminId], references: [id])

  signups VolunteerSignup[]
  adminAssignments EventAdminAssignment[]
}

model EventAdminAssignment {
  id        Int      @id @default(autoincrement())
  eventId   Int
  adminId   Int
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id])
  admin AdminUser @relation(fields: [adminId], references: [id])

  @@unique([eventId, adminId])
}

model VolunteerSignup {
  id                 Int      @id @default(autoincrement())
  fullName           String
  email              String?
  locationOrDepartment String
  status             String   @default("confirmed")
  selectedDates      String[]
  createdAt          DateTime @default(now())

  eventId Int
  event   Event @relation(fields: [eventId], references: [id])
}

model AdminUser {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  fullName           String?
  passwordHash       String
  mustChangePassword Boolean  @default(true)
  role               String   @default("event_admin")
  isActive           Boolean @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  createdEvents      Event[]
  eventAssignments   EventAdminAssignment[]
}